{
  "name": "streamflow-app",
  "version": "2.0.4",
  "description": "StreamFlow: A seamless torrent streaming and media management application.",
  "main": "main.js",
  "bin": {
    "streamflow-app": "backend/server.js"
  },
  "files": [
    "backend",
    "frontend/dist",
    "assets",
    "main.js",
    "package.json"
  ],
  "scripts": {
    "start": "electron .",
    "server": "node backend/server.js",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.streamflow.app",
    "productName": "StreamFlow",
    "icon": "assets/favicon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "RedaYasserSebaa",
        "repo": "StreamFlow"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/favicon.ico"
    },
    "linux": {
      "target": "deb",
      "category": "Video",
      "extraFiles": [
        {
          "from": "package/linux/streamflow.service",
          "to": "streamflow.service"
        }
      ],
      "synopsis": "Seamless torrent streaming and media management."
    },
    "deb": {
      "afterInstall": "package/linux/after-install.sh",
      "fpm": [
        "--before-remove",
        "package/linux/before-remove.sh"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "uninstallDisplayName": "StreamFlow"
    },
    "directories": {
      "output": "dist-installer"
    }
  },
  "keywords": [],
  "author": "Reda Yasser Sebaa <redfor767@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "got": "^14.6.6",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.8.0",
    "plyr": "^3.8.4",
    "qbittorrent": "^1.0.0",
    "react-router-dom": "^7.14.0",
    "torrent-stream": "^1.2.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2"
  }
}
